<div class="mb-5 pb-3 border-b border-slate-200 flex justify-between items-center gap-4">
  <div class="flex items-center gap-4">
    <h1 class="text-base font-semibold text-slate-900">Errors</h1>

    <div class="tab-group flex gap-1">
      <%= link_to "Active", error_logs_path(start_date: @start_date, end_date: @end_date), class: @hidden ? nil : "active" %>
      <%= link_to "Hidden (#{@hidden_class_count})", error_logs_path(start_date: @start_date, end_date: @end_date, hidden: true), class: @hidden ? "active" : nil %>
    </div>
  </div>

  <%= form_with url: request.path, method: :get, class: "flex items-center gap-2" do |f| %>
    <%= hidden_field_tag :hidden, true if @hidden %>
    <%= date_field_tag :start_date, @start_date %>
    <%= date_field_tag :end_date, @end_date %>
    <%= submit_tag "Submit", name: nil %>
  <% end %>
</div>
