<span class="inline-flex items-center gap-1.5" title="<%= browser_label(browser) %>">
  <% case browser %>
  <% when "Chrome" %>
    <svg viewBox="0 0 24 24" fill="none" class="size-4 text-slate-500 shrink-0"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M12 3v6M5.2 8l5.2 3M12 15l6.8-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  <% when "Firefox" %>
    <svg viewBox="0 0 24 24" fill="none" class="size-4 text-slate-500 shrink-0"><path d="M12 3c4.5 0 8 3.8 8 8.2 0 4.5-3.4 7.8-8 7.8s-8-3.4-8-7.7C4 7.6 7 4 12 3Z" stroke="currentColor" stroke-width="1.5"/></svg>
  <% when "Safari" %>
    <svg viewBox="0 0 24 24" fill="none" class="size-4 text-slate-500 shrink-0"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M15 9l-4.5 3L15 9l-1.5 6L15 9Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
  <% when "Edge" %>
    <svg viewBox="0 0 24 24" fill="none" class="size-4 text-slate-500 shrink-0"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M6 14c2 3 8 3 10-1-3 2-6 0-5-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  <% when "Opera" %>
    <svg viewBox="0 0 24 24" fill="none" class="size-4 text-slate-500 shrink-0"><ellipse cx="12" cy="12" rx="5" ry="8" stroke="currentColor" stroke-width="1.5"/></svg>
  <% when "Samsung Internet" %>
    <svg viewBox="0 0 24 24" fill="none" class="size-4 text-slate-500 shrink-0"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><ellipse cx="12" cy="12" rx="7" ry="3.4" stroke="currentColor" stroke-width="1.5" transform="rotate(-25 12 12)"/></svg>
  <% when "Mobile Safari" %>
    <svg viewBox="0 0 24 24" fill="none" class="size-4 text-slate-500 shrink-0"><rect x="8" y="2.5" width="8" height="19" rx="2" stroke="currentColor" stroke-width="1.5"/></svg>
  <% else %>
    <svg viewBox="0 0 24 24" fill="none" class="size-4 text-slate-400 shrink-0"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.5 2.5"/></svg>
  <% end %>
  <span class="<%= browser ? "text-slate-700" : "text-slate-400" %>"><%= browser_label(browser) %></span>
</span>
