<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/request_tracker/head" %>
  </head>

  <body class="bg-slate-50 text-slate-800" data-turbo="false">
    <header class="bg-slate-800 shadow-sm">
      <div class="container mx-auto px-5 py-2.5 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <%= link_to root_path, class: "flex gap-2 items-center text-white no-underline hover:no-underline hover:text-white" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
              <path d="M18.375 2.25c-1.035 0-1.875.84-1.875 1.875v15.75c0 1.035.84 1.875 1.875 1.875h.75c1.035 0 1.875-.84 1.875-1.875V4.125c0-1.036-.84-1.875-1.875-1.875h-.75ZM9.75 8.625c0-1.036.84-1.875 1.875-1.875h.75c1.036 0 1.875.84 1.875 1.875v11.25c0 1.035-.84 1.875-1.875 1.875h-.75a1.875 1.875 0 0 1-1.875-1.875V8.625ZM3 13.125c0-1.036.84-1.875 1.875-1.875h.75c1.036 0 1.875.84 1.875 1.875v6.75c0 1.035-.84 1.875-1.875 1.875h-.75A1.875 1.875 0 0 1 3 19.875v-6.75Z" />
            </svg>

            <span class="text-[13px] font-medium tracking-wide">Request Tracker</span>
          <% end %>
        </div>

        <nav class="flex items-center gap-5 text-[13px]">
          <%= nav_link_to "Requests", requests_path %>
          <%= nav_link_to "Errors", error_logs_path %>
          <%= nav_link_to "Jobs", job_logs_path %>
          <%= nav_link_to "Mailers", mailer_logs_path %>
        </nav>
      </div>
    </header>

    <main class="max-w-[1400px] mx-auto mt-6 mb-12 px-5">
      <% if flash[:notice].present? %>
        <div class="bg-green-50 text-green-700 border border-green-200 rounded-md p-3 mb-4 text-[13px]">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert].present? %>
        <div class="bg-red-50 text-red-700 border border-red-200 rounded-md p-3 mb-4 text-[13px]">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if content_for?(:full_bleed) %>
        <%= yield %>
      <% else %>
        <div class="card p-6">
          <%= yield %>
        </div>
      <% end %>
    </main>
  </body>
</html>
